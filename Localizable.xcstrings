    "cardImport.header.subtitle" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge deine Begriffe und Antworten ein. Eine Karte pro Zeile, getrennt durch einen Tabulator. Quizlet-Exporte funktionieren direkt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paste your terms and answers. One card per line, with the term and the answer separated by a tab. Quizlet exports work as they are."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pega tus términos y respuestas. Una tarjeta por línea, con el término y la respuesta separados por un tabulador. Las exportaciones de Quizlet funcionan tal cual."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Collez vos termes et vos réponses. Une carte par ligne, le terme et la réponse séparés par une tabulation. Les exports Quizlet fonctionnent tels quels."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "問題と解答を貼り付けてください。1行につき1枚のカードで、問題と解答はタブで区切ります。Quizletのエクスポートはそのまま使えます。"
          }
        }
      }
    },
