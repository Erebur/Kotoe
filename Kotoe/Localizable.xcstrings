    "contentView.header.emptySummary": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create a subject to organize your flashcard sets."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstelle ein Fach, um deine Kartensets zu organisieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea una asignatura para organizar tus conjuntos de tarjetas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créez une matière pour organiser vos séries de cartes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "科目を作成してカードセットを整理しましょう。"
