    "contentView.emptyState.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Subjects keep your sets organized — one for each course, language, or topic you're learning."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fächer halten deine Sets geordnet – eines für jeden Kurs, jede Sprache oder jedes Thema, das du lernst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las asignaturas mantienen tus conjuntos organizados: una para cada curso, idioma o tema que estudies."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les matières organisent vos séries : une pour chaque cours, langue ou sujet que vous étudiez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "科目ごとに、学習中のコースや言語、トピックのセットを整理できます。"
          }
        }
      }
    },
