          }
        }
      }
    },
    "contentView.deleteSubjectDialog.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld cards in %lld sets will be deleted. This can't be undone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Karten in %lld Sets werden gelöscht. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán %lld tarjetas en %lld conjuntos. Esta acción no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld cartes dans %lld séries seront supprimées. Cette action est irréversible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld枚のカードが%lld個のセットから削除されます。この操作は取り消せません。"
          }
        }
      }
    },
