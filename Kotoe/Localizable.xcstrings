        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los conjuntos agrupan varias tarjetas relacionadas, como un capítulo o un tema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les séries regroupent quelques cartes liées, comme un chapitre ou un thème."
