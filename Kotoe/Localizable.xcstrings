    "contentView.newSubjectSheet.prompt": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A subject groups related flashcard sets, like a course or a language."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Fach bündelt verwandte Kartensets, etwa einen Kurs oder eine Sprache."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una asignatura agrupa conjuntos de tarjetas relacionados, como un curso o un idioma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une matière regroupe des séries de cartes liées, comme un cours ou une langue."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "科目は、コースや言語など、関連するカードセットをまとめます。"
          }
        }
      }
    },
